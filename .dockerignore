# The build context is this directory, so host build output would otherwise be
# uploaded to the builder — backend/target alone is ~2GB — and a copied-in
# node_modules makes `pnpm install` abort ("Aborted removal of modules
# directory due to no TTY"). Everything the image needs is built inside it.
**/node_modules
backend/target
backend/bug-data
bug-data

# Not copied by any stage; excluded purely to keep the context small.
.git
e2e
integration_tests
skills
*.png

# Frontend build output is regenerated by `pnpm run build` in the image.
# Note frontend/public itself is NOT ignored: index.html and the icons are
# checked-in files that the server ships.
frontend/public/bundle.js
